{
  "name": "web-app-template",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "workbook:generate": "npm run workbook:generate --workspace=packages/workbook-engine"
  },
  "devDependencies": {
    "@types/node": "22.5.5",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "object-inspect": "^1.13.4",
    "supertest": "^7.3.0"
  }
}
