{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KV01 calculation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "min_qty",
    "max_qty"
  ],
  "properties": {
    "min_qty": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "max_qty": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  }
}
