{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NS02 calculation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clock_in",
    "clock_out"
  ],
  "properties": {
    "clock_in": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "clock_out": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
