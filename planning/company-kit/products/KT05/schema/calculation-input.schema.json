{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KT05 calculation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "net_revenue",
    "cost"
  ],
  "properties": {
    "net_revenue": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "cost": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  }
}
