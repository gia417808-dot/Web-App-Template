{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SX04 calculation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defective_units",
    "inspected_units"
  ],
  "properties": {
    "defective_units": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "inspected_units": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  }
}
