{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MK03 calculation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "converted",
    "valid_leads"
  ],
  "properties": {
    "converted": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "valid_leads": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  }
}
