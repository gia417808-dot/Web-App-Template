{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MK01 calculation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "published_on_time",
    "due_count"
  ],
  "properties": {
    "published_on_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "due_count": {
      "type": [
        "string",
        "null"
      ],
      "description": "Giá trị nhập của calculator contract; null được trả lỗi/reason theo oracle.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    }
  }
}
